generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model PanelUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Device {
  id           String        @id @default(cuid())
  name         String
  baseUrl      String
  login        String
  passwordEnc  String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  dispatchLogs DispatchLog[]
  accessEvents AccessEvent[]
}

model User {
  id           Int           @id @default(autoincrement())
  deviceUserId Int?          @unique
  registration String        @unique
  name         String
  photoPath    String?
  createdAt    DateTime      @default(now())
  dispatchLogs DispatchLog[]
}

model DispatchLog {
  id        String   @id @default(cuid())
  userId    Int
  deviceId  String
  action    String
  ok        Boolean
  message   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// Passagens lidas das faciais pelo coletor (src/lib/access-collector.ts).
// time é Unix em segundos, já convertido para UTC real.
model AccessEvent {
  id           Int     @id @default(autoincrement())
  deviceId     String
  deviceLogId  Int
  time         Int
  event        Int // código Control iD (7 = acesso liberado)
  direction    String // "entry" | "exit" | "pass"
  portalId     Int?
  deviceUserId Int
  userName     String
  registration String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceLogId, time])
  @@index([time])
  @@index([deviceUserId, time])
}
